{
  "tests": [
    {
      "name": "GET assignees list",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200,
      "bodyMatcher": "none"
    },
    {
      "name": "Login without body returns 400",
      "method": "POST",
      "path": "/?action=login",
      "body": {},
      "expectedStatus": 400,
      "bodyMatcher": "none"
    },
    {
      "name": "Login unknown email returns 403",
      "method": "POST",
      "path": "/?action=login",
      "body": {"email": "unknown@example.com", "password": "test"},
      "expectedStatus": 403,
      "bodyMatcher": "none"
    }
  ]
}